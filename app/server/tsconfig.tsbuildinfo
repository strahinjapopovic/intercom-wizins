{
    "fileNames": [],
    "fileInfos": [],
    "root": [],
    "options": {
        "allowJs": true,
        "composite": true,
        "declaration": true,
        "declarationMap": true,
        "exactOptionalPropertyTypes": true,
        "jsx": 4,
        "module": 199,
        "noUncheckedIndexedAccess": true,
        "noUncheckedSideEffectImports": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "target": 99,
        "verbatimModuleSyntax": true
    },
    "version": "6.0.3"
}