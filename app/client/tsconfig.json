{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/client",
    "rootDir": "..",
    "composite": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "esModuleInterop": true 
  },
  "include": ["src/**/*", "**/*.d.ts", "types", "../utils/**/*.js", "../utils/auth.ts"],
  "exclude": [
    "node_modules",
    "dist"
  ],
}