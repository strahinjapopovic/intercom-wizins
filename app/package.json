{
  "name": "app",
  "type": "module",
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "description": "",
  "scripts": {
    "start": "nodemon ./server/server.ts",
    "dev": "set NODE_OPTIONS=--no-warnings&& concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd ./server && set NODE_OPTIONS=--no-deprecation --no-warnings&& npm run watch",
    "dev:client": "cd ./client && set BROWSERSLIST_IGNORE_OLD_DATA=true&& concurrently \"npm run codegen:watch\" \"npm run dev\"",
    "build": "cd ./client && npm run build",
    "seed": "cd ./server && npm run seed",
    "codegen:client": "npm run codegen:watch -w client",
    "lint": "eslint .",
    "preview": "cd ./client && npm run preview"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tsx": "^4.23.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  },
  "dependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "bcryptjs": "^3.0.2",
    "nodemon": "^3.1.14",
    "npm": "^11.13.0",
    "react-icons": "^5.4.0",
    "ts-node": "^10.9.2",
    "vite-plugin-html": "^3.2.2"
  }
}
